<UserControl
    x:Class="Portal.Core.UI.Controls.PowerFlowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="190">
    <UserControl.Resources>
        <Style x:Key="FlowRibbonBaseStyle" TargetType="Path">
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Opacity" Value="0.38" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="FlowRibbonDotsStyle" TargetType="Path">
            <Setter Property="StrokeDashCap" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="FlowRibbonMissingStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorDisabledBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="3,3" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="FlowTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="FlowLabelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="FlowLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="FlowCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="FlowCanvas" Background="Transparent">
        <!-- Charger to system: neutral -->
        <Path x:Name="AcSystemBase" Style="{StaticResource FlowRibbonBaseStyle}" Stroke="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        <Path x:Name="AcSystemDots" Style="{StaticResource FlowRibbonDotsStyle}" Stroke="{ThemeResource TextFillColorSecondaryBrush}" />
        <Path x:Name="AcSystemMissing" Style="{StaticResource FlowRibbonMissingStyle}" />
        <!-- Charger to battery: accent, carries the charge -->
        <Path x:Name="AcBatteryBase" Style="{StaticResource FlowRibbonBaseStyle}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
        <Path x:Name="AcBatteryDots" Style="{StaticResource FlowRibbonDotsStyle}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
        <Path x:Name="AcBatteryMissing" Style="{StaticResource FlowRibbonMissingStyle}" />
        <!-- Battery to system: neutral -->
        <Path x:Name="DcSystemBase" Style="{StaticResource FlowRibbonBaseStyle}" Stroke="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        <Path x:Name="DcSystemDots" Style="{StaticResource FlowRibbonDotsStyle}" Stroke="{ThemeResource TextFillColorSecondaryBrush}" />
        <Path x:Name="DcSystemMissing" Style="{StaticResource FlowRibbonMissingStyle}" />

        <Border x:Name="ChargerTile" Style="{StaticResource FlowTileStyle}">
            <FontIcon x:Name="ChargerIcon" Glyph="&#xE83E;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Border>
        <Border x:Name="SystemTile" Style="{StaticResource FlowTileStyle}">
            <FontIcon x:Name="SystemIcon" Glyph="&#xE7F8;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
        <Border x:Name="BatteryTile" Style="{StaticResource FlowTileStyle}">
            <FontIcon x:Name="BatteryIcon" Glyph="&#xE83F;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>

        <TextBlock x:Name="ChargerCaption" Style="{StaticResource FlowCaptionStyle}" />
        <TextBlock x:Name="SystemCaption" Style="{StaticResource FlowCaptionStyle}" />
        <TextBlock x:Name="BatteryCaption" Style="{StaticResource FlowCaptionStyle}" />

        <Border x:Name="AcSystemLabel" Style="{StaticResource FlowLabelStyle}">
            <TextBlock x:Name="AcSystemLabelText" Style="{StaticResource FlowLabelTextStyle}" />
        </Border>
        <Border x:Name="AcBatteryLabel" Style="{StaticResource FlowLabelStyle}">
            <TextBlock x:Name="AcBatteryLabelText" Style="{StaticResource FlowLabelTextStyle}" />
        </Border>
        <Border x:Name="DcSystemLabel" Style="{StaticResource FlowLabelStyle}">
            <TextBlock x:Name="DcSystemLabelText" Style="{StaticResource FlowLabelTextStyle}" />
        </Border>
    </Canvas>
</UserControl>
