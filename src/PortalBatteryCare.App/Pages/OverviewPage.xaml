<Page
    x:Class="PortalBatteryCare.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="TitleOverview" Style="{StaticResource TitleTextBlockStyle}" />

            <Border x:Name="BatteryCard" Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LevelText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock x:Name="StatusText" />
                    <TextBlock x:Name="RateText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SimulatedText" x:Uid="OverviewSimulated" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SupportCardTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="DeviceText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="SentenceText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LimitText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="CheckAgainButton" x:Uid="SupportCheckAgain" Click="OnCheckAgain" />
                        <Button x:Name="CopyButton" x:Uid="SupportCopyReport" Click="OnCopyReport" />
                        <Button x:Name="SaveButton" x:Uid="SupportSaveReport" Click="OnSaveReport" />
                    </StackPanel>
                    <InfoBar x:Name="ReportInfo" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
