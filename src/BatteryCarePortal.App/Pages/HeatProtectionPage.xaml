<Page
    x:Class="BatteryCarePortal.Pages.HeatProtectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="Column" Padding="32,24" Spacing="16" MaxWidth="720">
            <TextBlock x:Uid="TitleHeatProtection" Style="{StaticResource TitleTextBlockStyle}" />

            <Border x:Name="ReadingCard" Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="SwitchTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border x:Name="SimulatedChip" Visibility="Collapsed" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock x:Uid="OverviewSimulated" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="NowText" TextWrapping="Wrap" />
                    <Canvas x:Name="Scale" Height="86" />
                    <StackPanel x:Name="ThresholdRow" Orientation="Horizontal" Spacing="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ThresholdTitle" />
                            <TextBlock x:Name="ThresholdRange" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="LessButton" Content="−" Click="OnLess" MinWidth="40" />
                        <TextBlock x:Name="ThresholdValue" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center" />
                        <Button x:Name="MoreButton" Content="+" Click="OnMore" MinWidth="40" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="WhatCard" Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="WhatTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="WhatText" TextWrapping="Wrap" />
                    <TextBlock x:Name="NotActiveText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
