<Page
    x:Class="BatteryCarePortal.Pages.PowerFlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="Column" Padding="32,24" Spacing="16" MaxWidth="720">
            <TextBlock x:Uid="TitlePowerFlow" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Padding="20" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="StateText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border x:Name="SimulatedChip" Visibility="Collapsed" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock x:Uid="OverviewSimulated" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                    <Border x:Name="FlowHost" MinHeight="190" />
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LegendText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
