<Page
    x:Class="BatteryCarePortal.Pages.ChargingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel x:Name="Column" Padding="32,24" Spacing="16" MaxWidth="720">
            <TextBlock x:Uid="TitleCharging" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar x:Name="NoticeInfo" IsOpen="False" IsClosable="False" Severity="Warning">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button x:Name="NoticePrimaryButton" Click="OnNoticePrimary" />
                        <Button x:Name="NoticeSecondaryButton" Click="OnNoticeSecondary" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar x:Name="StatusInfo" IsOpen="False" IsClosable="True" />

            <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" Visibility="Collapsed" />

            <Border x:Name="LimitCard" Padding="20" CornerRadius="{ThemeResource BcpCardRadius}" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="ChargeLimitTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border x:Name="BetaChip" Visibility="Collapsed" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock x:Uid="ChargeBetaChip" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="CapabilityText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="LimitSwitch" x:Uid="ChargeLimitSwitch" Toggled="OnLimitToggled" />
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="ValuePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Slider x:Name="ValueSlider" Width="260" StepFrequency="1" TickFrequency="5" TickPlacement="Outside" Visibility="Collapsed" />
                        <ComboBox x:Name="ValueCombo" MinWidth="120" Visibility="Collapsed" />
                        <Button x:Name="ApplyValueButton" x:Uid="ChargeApplyValue" Click="OnApplyValue" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ReadBackText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border x:Name="TopUpCard" Padding="20" CornerRadius="{ThemeResource BcpCardRadius}" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ChargeTopUpTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="TopUpText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TopUpButton" x:Uid="ChargeTopUpButton" Style="{StaticResource AccentButtonStyle}" Click="OnTopUp" />
                        <Button x:Name="StopTopUpButton" x:Uid="ChargeTopUpStop" Click="OnStopTopUp" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="RestoreCard" Padding="20" CornerRadius="{ThemeResource BcpCardRadius}" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ChargeRestoreTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="ChargeRestoreText" TextWrapping="Wrap" />
                    <Button x:Name="RestoreButton" x:Uid="ChargeRestoreButton" Click="OnRestore" />
                    <StackPanel x:Name="ResetPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Uid="ChargeResetText" TextWrapping="Wrap" />
                        <Button x:Name="ResetStateButton" x:Uid="ChargeResetButton" Click="OnResetState" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
