<UserControl
    x:Class="BatteryCarePortal.WelcomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Padding="20" CornerRadius="{ThemeResource BcpCardRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StepText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel x:Name="Page0" Spacing="12">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
                        <TextBlock x:Name="DeviceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="DeviceText" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="LimitPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="LimitTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock x:Name="LimitText" TextWrapping="Wrap" />
                            <Button x:Name="ActionButton" Style="{StaticResource AccentButtonStyle}" Click="OnAction" />
                            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="False" />
                            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
                        </StackPanel>
                        <StackPanel x:Name="PpmPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="PpmTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock x:Name="PpmText" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="Page1" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="PrefsTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="StartupPanel" Spacing="4">
                            <TextBlock x:Name="StartupTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="StartupText" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="StartupSwitch" Toggled="OnStartupToggled" />
                            <TextBlock x:Name="StartupDetail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="NotifyPanel" Spacing="4">
                            <TextBlock x:Name="NotifyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="NotifyText" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="NotifyLimitSwitch" Toggled="OnNotifyToggled" />
                            <ToggleSwitch x:Name="NotifyPlugInSwitch" Toggled="OnNotifyToggled" />
                            <ToggleSwitch x:Name="NotifyTopUpSwitch" Toggled="OnNotifyToggled" />
                        </StackPanel>
                        <StackPanel x:Name="CrashPanel" Spacing="4">
                            <TextBlock x:Name="CrashTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="CrashText" TextWrapping="Wrap" />
                            <CheckBox x:Name="CrashSwitch" IsChecked="True" Checked="OnCrashToggled" Unchecked="OnCrashToggled" />
                            <HyperlinkButton x:Name="CrashLink" Padding="0" HorizontalAlignment="Left" Click="OnCrashWhatsSent" />
                        </StackPanel>
                        <InfoBar x:Name="PrefsInfo" IsOpen="False" IsClosable="False" />
                    </StackPanel>

                    <StackPanel x:Name="Page2" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="TrayTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TrayText" TextWrapping="Wrap" />
                        <TextBlock x:Name="FreeText" TextWrapping="Wrap" />
                        <TextBlock x:Name="FinishText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel x:Name="Dots" Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Click="OnSkip" />
            <Button x:Name="RecommendedButton" Grid.Column="1" Click="OnRecommended" />
            <Button x:Name="BackButton" Grid.Column="3" Click="OnBack" />
            <Button x:Name="NextButton" Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="OnNext" />
        </Grid>
    </Grid>
</UserControl>
