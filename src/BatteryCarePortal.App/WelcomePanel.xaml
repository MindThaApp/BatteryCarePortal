<UserControl
    x:Class="BatteryCarePortal.WelcomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="WelcomeTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="WelcomeBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WelcomeCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource BcpCardRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Pages">
            <!-- Step 1: why a charge limit helps, and this laptop -->
            <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto" IsTabStop="False" SizeChanged="OnPage0SizeChanged">
                <Grid x:Name="Page0Content"><StackPanel Padding="32,24,32,8" Spacing="14" VerticalAlignment="Center">
                    <Grid x:Name="Hero0" MinHeight="150">
                        <Border x:Name="Tint0" Opacity="0.14" CornerRadius="{ThemeResource BcpCardRadius}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border CornerRadius="{ThemeResource BcpCardRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <FontIcon Glyph="&#xE83F;" FontSize="80" Margin="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock x:Name="TitleText" Style="{StaticResource WelcomeTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="BodyText" Style="{StaticResource WelcomeBodyStyle}" />
                    <Border Style="{StaticResource WelcomeCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DeviceTitle" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DeviceText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel></Grid>
            </ScrollViewer>

            <!-- Step 2: pick a limit; nothing is applied until the button is pressed -->
            <ScrollViewer x:Name="Page1" VerticalScrollBarVisibility="Auto" IsTabStop="False" Visibility="Collapsed">
                <StackPanel Padding="32,24,32,8" Spacing="14">
                    <Grid x:Name="Hero1" MinHeight="112">
                        <Border x:Name="Tint1" Opacity="0.14" CornerRadius="{ThemeResource BcpCardRadius}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border CornerRadius="{ThemeResource BcpCardRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <FontIcon Glyph="&#xE945;" FontSize="56" Margin="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock x:Name="LimitHeading" Style="{StaticResource WelcomeTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="LimitBody" Style="{StaticResource WelcomeBodyStyle}" />
                    <Border x:Name="LimitPanel" Style="{StaticResource WelcomeCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="LimitValue" FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="LimitValueCaption" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="LimitText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="ActionButton" Style="{StaticResource AccentButtonStyle}" Click="OnAction" />
                                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
                            </StackPanel>
                            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="False" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="UnavailablePanel" Style="{StaticResource WelcomeCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="UnavailableTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="PpmPanel" Style="{StaticResource WelcomeCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="PpmTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="PpmText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 3: where the tray is, and your choices -->
            <ScrollViewer x:Name="Page2" VerticalScrollBarVisibility="Auto" IsTabStop="False" Visibility="Collapsed">
                <StackPanel Padding="32,20,32,8" Spacing="10">
                    <Grid x:Name="Hero2" MinHeight="72">
                        <Border x:Name="Tint2" Opacity="0.14" CornerRadius="{ThemeResource BcpCardRadius}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Border CornerRadius="{ThemeResource BcpCardRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Border x:Name="TrayIllustration" Margin="12" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="{ThemeResource BcpCardRadius}" BorderThickness="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Padding="8,6" CornerRadius="{ThemeResource BcpCardRadius}" BorderThickness="1"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE83F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <FontIcon Glyph="&#xE701;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="12:30" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TrayTitle" Style="{StaticResource WelcomeTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="TrayText" Style="{StaticResource WelcomeBodyStyle}" />

                    <Border x:Name="StartupPanel" Style="{StaticResource WelcomeCardStyle}" Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StartupTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="StartupText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="StartupDetail" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnStartupToggled" />
                        </Grid>
                    </Border>

                    <Border x:Name="CrashPanel" Style="{StaticResource WelcomeCardStyle}" Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CrashLine" TextWrapping="Wrap" />
                                <HyperlinkButton x:Name="CrashLink" Padding="0" HorizontalAlignment="Left"
                                                 AutomationProperties.Name="What's sent" />
                            </StackPanel>
                            <CheckBox x:Name="CrashSwitch" Grid.Column="1" MinWidth="0" IsChecked="True" Checked="OnCrashToggled" Unchecked="OnCrashToggled" />
                        </Grid>
                    </Border>

                    <Border x:Name="NotifyPanel" Style="{StaticResource WelcomeCardStyle}" Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NotifyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="NotifyText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotifySwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnNotifyToggled" />
                        </Grid>
                    </Border>
                    <InfoBar x:Name="PrefsInfo" IsOpen="False" IsClosable="False" />
                    <TextBlock x:Name="FreeText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel x:Name="Dots" Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />

        <Grid x:Name="Footer" Grid.Row="2" Padding="32,4,32,20" ColumnSpacing="8" RowSpacing="8" SizeChanged="OnFooterSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FooterLeft" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SkipButton" Click="OnSkip" />
                <Button x:Name="RecommendedButton" Click="OnRecommended" />
            </StackPanel>
            <StackPanel x:Name="FooterRight" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Click="OnBack" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Click="OnNext" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
