<UserControl
    x:Class="BatteryCarePortal.WelcomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Padding="20" Margin="32" MaxWidth="600" CornerRadius="8" VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StepText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="ActionButton" Style="{StaticResource AccentButtonStyle}" Click="OnAction" Visibility="Collapsed" />
                    <ToggleSwitch x:Name="StartupSwitch" Visibility="Collapsed" />
                    <StackPanel x:Name="NotifyPanel" Spacing="4" Visibility="Collapsed">
                        <ToggleSwitch x:Name="NotifyLimitSwitch" />
                        <ToggleSwitch x:Name="NotifyPlugInSwitch" />
                        <ToggleSwitch x:Name="NotifyTopUpSwitch" />
                    </StackPanel>
                    <StackPanel x:Name="CrashSlot" Spacing="4" Visibility="Collapsed">
                        <ToggleSwitch x:Name="CrashSwitch" IsOn="False" />
                    </StackPanel>
                    <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="False" />

                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="BackButton" Click="OnBack" />
                        <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Click="OnNext" />
                        <HyperlinkButton x:Name="SkipButton" Click="OnSkip" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
