<Window
    x:Class="BatteryCarePortal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="NavOverview" Tag="Overview" Icon="Home" />
            <NavigationViewItem x:Uid="NavCharging" Tag="Charging" Icon="Calendar" />
            <NavigationViewItem x:Uid="NavHeat" Tag="HeatProtection" Icon="Remote" />
            <NavigationViewItem x:Uid="NavPowerFlow" Tag="PowerFlow" Icon="Sync" />
            <NavigationViewItem x:Uid="NavHistory" Tag="History" Icon="Clock" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Border x:Name="SimulatedBadge" Visibility="Collapsed" Margin="12,0,12,8" Padding="8,4" CornerRadius="4"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock x:Uid="OverviewSimulated" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </Border>
        </NavigationView.PaneFooter>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="NavSettings" Tag="Settings" Icon="Setting" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>

    </Grid>
</Window>
