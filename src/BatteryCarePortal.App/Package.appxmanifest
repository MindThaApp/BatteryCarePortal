<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap5 rescap com desktop">

  <!-- Name and Publisher are placeholders until the Store reservation exists; replace with the values Partner Center shows. -->
  <Identity
    Name="34458MindtheApp.BatteryCarePortal"
    Publisher="CN=PLACEHOLDER-STORE-PUBLISHER-ID"
    Version="0.3.0.0" />

  <Properties>
    <DisplayName>Battery Care Portal</DisplayName>
    <PublisherDisplayName>MindtheApp</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="BatteryCarePortal"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Battery Care Portal"
        Description="Keeps a laptop battery healthy for years."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask
            TaskId="BatteryCarePortalStartup"
            Enabled="false"
            DisplayName="Battery Care Portal" />
        </uap5:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="battery-care-portal">
            <uap:DisplayName>Battery Care Portal</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- Notification clicks: the CLSID must match in both entries. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="0D4B3E75-044D-4D4E-B0EC-AD582EA1FF77" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="BatteryCarePortal.App.exe" Arguments="----AppNotificationActivated:" DisplayName="Battery Care Portal">
              <com:Class Id="0D4B3E75-044D-4D4E-B0EC-AD582EA1FF77" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
