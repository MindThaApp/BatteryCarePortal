<UserControl
    x:Class="BatteryCarePortal.TrayFlyoutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <CornerRadius x:Key="BcpTrayTileRadius">20</CornerRadius>
        <Style x:Key="TrayTileCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource BcpTrayTileRadius}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="TrayTileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TrayTileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="TrayTileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TrayTileError" TargetType="TextBlock" BasedOn="{StaticResource TrayTileCaption}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="TrayAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
    </UserControl.Resources>

    <Grid x:Name="PaneRoot" CornerRadius="8" XYFocusKeyboardNavigation="Enabled">
        <Border x:Name="PaneFill" CornerRadius="8" Opacity="0.82"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="12,10,12,8" Spacing="2">
                <TextBlock x:Name="HeaderText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="DeviceText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" x:Name="TileScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <Grid x:Name="TileGrid" Padding="4,2,4,6" ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Padding="4,6,4,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" HorizontalAlignment="Stretch" Click="OnOpen" />
                <Button x:Name="EditButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnEditToggle" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
