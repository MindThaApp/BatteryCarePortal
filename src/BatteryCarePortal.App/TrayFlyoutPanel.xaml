<UserControl
    x:Class="BatteryCarePortal.TrayFlyoutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel Padding="16" Spacing="12">
            <TextBlock x:Name="DeviceText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="RingHost" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="LevelText" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border x:Name="LimitCard" Padding="12" CornerRadius="8" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LimitTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="LimitHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
                            <ToggleSwitch x:Name="LimitSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnLimitToggled" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FailedText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

            <Button x:Name="TopUpButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed" Click="OnTopUp" />
            <Button x:Name="StopTopUpButton" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnStopTopUp" />

            <Button x:Name="OpenButton" HorizontalAlignment="Stretch" Click="OnOpen" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
