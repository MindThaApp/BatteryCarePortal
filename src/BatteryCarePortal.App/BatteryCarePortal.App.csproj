<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BatteryCarePortal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <UseSystemDrawing>true</UseSystemDrawing>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <GenerateAppxPackageOnBuild Condition="'$(MakeTestPackage)' == 'true'">true</GenerateAppxPackageOnBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Crash reports: no global `using Sentry;`, no native crash handler (it would send past the consent gate and the redaction),
         and no source generator (it stamps this machine's project folder into the assembly). -->
    <SentryImplicitUsings>false</SentryImplicitUsings>
    <SentryNative>false</SentryNative>
    <SentryDisableSourceGenerator>true</SentryDisableSourceGenerator>
    <!-- store / beta / dev: plain Debug build = dev, Release = store; make-test-package.ps1 passes beta. -->
    <BcpChannel Condition="'$(BcpChannel)' == '' and '$(Configuration)' == 'Debug'">dev</BcpChannel>
    <BcpChannel Condition="'$(BcpChannel)' == ''">store</BcpChannel>
  </PropertyGroup>

  <!-- The package stamps the build machine's project folder into the assembly (Sentry.ProjectDirectory); ship no build paths. -->
  <Target Name="BcpDropSentryAttributes" AfterTargets="WriteSentryAttributes" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)$(SentryAttributesFile)" />
    </ItemGroup>
  </Target>

  <!-- The repository is public: the DSN is not committed. It is read at build time from secrets\sentry-dsn.txt (git-ignored) and
       written into a generated file under obj\. No file means an empty DSN and crash reporting stays off. -->
  <PropertyGroup>
    <BcpDsnFile>$(MSBuildThisFileDirectory)..\..\secrets\sentry-dsn.txt</BcpDsnFile>
  </PropertyGroup>
  <Target Name="BcpGenerateCrashConfig" BeforeTargets="MarkupCompilePass1;XamlPreCompile;CoreCompile">
    <PropertyGroup>
      <BcpDsnConfigFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)BcpCrashConfig.g.cs</BcpDsnConfigFile>
      <BcpDsnValue Condition="Exists('$(BcpDsnFile)')">$([System.IO.File]::ReadAllText('$(BcpDsnFile)').Trim())</BcpDsnValue>
      <BcpDsnValue Condition="'$(BcpDsnValue)' == ''"></BcpDsnValue>
    </PropertyGroup>
    <WriteLinesToFile File="$(BcpDsnConfigFile)" Lines="namespace BatteryCarePortal%3B internal static class CrashReportConfig { public const string Dsn = &quot;$(BcpDsnValue)&quot;%3B public const string Channel = &quot;$(BcpChannel)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BcpDsnConfigFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="Sentry" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WhatsNew\*.json" LogicalName="WhatsNew.%(Filename)%(Extension)" />
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portal.Core\Portal.Core.csproj" />
    <ProjectReference Include="..\Portal.Core.UI\Portal.Core.UI.csproj" />
  </ItemGroup>
</Project>
